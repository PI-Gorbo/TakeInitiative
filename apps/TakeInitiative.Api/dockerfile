# Build context is the repo root (see compose.dev.yml), so the API can reference
# packages/TakeInitiative.Dice. What gets sent is allowlisted in dockerfile.dockerignore.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Project files first, so restore is cached until a dependency changes.
COPY Directory.Build.props ./
COPY packages/TakeInitiative.Dice/TakeInitiative.Dice.csproj packages/TakeInitiative.Dice/
COPY apps/TakeInitiative.Api/TakeInitiative.Api.csproj apps/TakeInitiative.Api/
RUN dotnet restore apps/TakeInitiative.Api/TakeInitiative.Api.csproj

COPY packages/TakeInitiative.Dice/ packages/TakeInitiative.Dice/
COPY apps/TakeInitiative.Api/ apps/TakeInitiative.Api/
RUN dotnet publish apps/TakeInitiative.Api/TakeInitiative.Api.csproj -c Release -o /app/out --no-restore

# Now, from the published layer, we take the artifacts and place them into their own layer for running.
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR ./app
COPY --from=build /app/out ./

# curl is here only for the compose healthcheck.
RUN apt-get update && apt-get install curl -y \
    && rm -rf /var/lib/apt/lists/*

ENV ASPNETCORE_HTTP_PORTS=8080
EXPOSE 8080

# Start the application
ENTRYPOINT ["dotnet", "TakeInitiative.Api.dll"]
