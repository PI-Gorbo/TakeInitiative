# Local development only. `pnpm setup:env` copies this to .env, which nuxt reads at
# BUILD/dev time. A built container image ignores these entirely: set
# NUXT_PUBLIC_AXIOS_BASE_URL and NUXT_PUBLIC_WEB_URL on the container instead, and
# Nitro applies them per request (see docs/roadmap/29-deploy.md, 29d).
API_URL=http://localhost:5010
WEB_URL=http://localhost:3000
