<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <Version>1.2.2</Version>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <IsTestProject>false</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AWSSDK.S3" Version="4.0.103.4" />
        <PackageReference Include="CSharpFunctionalExtensions" Version="2.40.3" />
        <PackageReference Include="FastEndpoints" Version="5.22.0" />
        <PackageReference Include="FastEndpoints.Security" Version="5.21.2" />
        <PackageReference Include="FastEndpoints.Swagger" Version="5.22.0" />
        <PackageReference Include="Handlebars.Net" Version="2.1.6" />
        <PackageReference Include="Markdig" Version="1.4.0" />
        <PackageReference Include="Marten" Version="9.45.0" />
        <!-- Marten 9 removed runtime code generation. What replaced it for the five snapshotted
             aggregates is JasperFx.Events.SourceGenerator, and the Marten package already ships
             that analyzer itself (analyzers/dotnet/cs), so the evolvers are generated by the
             reference above with nothing else asked for. Referencing
             JasperFx.Events.SourceGenerator directly on top of it is the documented cause of a
             CS0433 from two copies of the same generator, so do not add it.

             Marten.SourceGenerator is deliberately NOT referenced. It is a different, smaller
             thing: its own description scopes it to compiled-query handler scaffolding for AOT
             publishing (Marten #4405). This project has no ICompiledQuery and does not publish
             AOT, so it would emit nothing. -->
        <!-- A direct pin that only exists to lift a vulnerable transitive version:
             JwtBearer 8.0.0 (via FastEndpoints.Security) dragged in
             Microsoft.IdentityModel.* 7.0.3 (GHSA-59j7-ghrg-fj52).

             The OpenTelemetry.Api pin that sat here is gone (step 30c). It existed because
             Marten 7.31.1 dragged in OpenTelemetry.Api 1.8.0 (GHSA-g94r-2vxg-569j), and
             Marten 9.45.0 does not depend on OpenTelemetry at all. No code references it,
             and nothing pulls it transitively any more, so the package is simply dropped
             rather than pinned to a version nothing asks for. -->
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
        <PackageReference Include="Mjml.Net" Version="3.11.0" />
        <PackageReference Include="SendGrid" Version="9.29.3" />
        <PackageReference Include="SendGrid.Extensions.DependencyInjection" Version="1.0.1" />
        <PackageReference Include="Serilog" Version="3.1.1" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
        <PackageReference Include="SkiaSharp" Version="4.152.1" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.1" />
        <PackageReference Include="xunit" Version="2.8.0" />
        <PackageReference Include="xunit.analyzers" Version="1.13.0" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>$(MSBuildProjectName).Tests</_Parameter1>
        </AssemblyAttribute>
        <EmbeddedResource Include="Embedded/ConfirmationEmail.mjml" />
        <EmbeddedResource Include="Embedded/ResetPasswordEmail.mjml" />
        <!-- SRD 5.2's monsters (step 20a), written by scripts/srd/build-srd52.mjs. Embedded, not
             copied as content: the API reads them from its own assembly. -->
        <Content Remove="Reference/**/*.json" />
        <EmbeddedResource Include="Reference/Srd52/*.json" LogicalName="TakeInitiative.Api.Reference.Srd52.%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\packages\TakeInitiative.Dice\TakeInitiative.Dice.csproj" />
      <!-- The knowledge base (26c). The API needs the table's DDL and column names so that
           ApplyAllDatabaseChangesOnStartup creates the table the ingest CLI writes to; 26d's
           reference provider then reads it. The package pulls in Npgsql, which Marten already
           brought, and nothing else. -->
      <ProjectReference Include="..\..\packages\TakeInitiative.KnowledgeBase\TakeInitiative.KnowledgeBase.csproj" />
    </ItemGroup>
</Project>